<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- 48dp/27dp keeps content inside the Android TV overscan-safe area. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/setup_text"
            android:textSize="32sp" />

        <TextView
            style="@style/SetupBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/setup_subtitle"
            android:textSize="17sp" />

        <!-- Step 1: accessibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/setup_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SetupStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_accessibility_title" />

                <TextView
                    style="@style/SetupBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/step_accessibility_body" />

                <TextView
                    android:id="@+id/accessibilityStatus"
                    style="@style/SetupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/accessibilityButton"
                style="@style/SetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_open_settings" />
        </LinearLayout>

        <!-- Step 2: overlay permission -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/setup_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SetupStepTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_overlay_title" />

                <TextView
                    style="@style/SetupBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/step_overlay_body" />

                <TextView
                    android:id="@+id/overlayStatus"
                    style="@style/SetupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/overlayButton"
                style="@style/SetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_grant" />
        </LinearLayout>

        <!-- Step 3: soundbar status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/setup_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SetupStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_soundbar_title" />

            <TextView
                style="@style/SetupBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_soundbar_body" />

            <TextView
                android:id="@+id/soundbarStatus"
                style="@style/SetupStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Step 4: volume per input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/setup_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SetupStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_input_volume_title" />

            <TextView
                style="@style/SetupBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/step_input_volume_body" />

            <Switch
                android:id="@+id/inputVolumeSwitch"
                style="@style/SetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:switchPadding="16dp"
                android:text="@string/input_volume_switch" />

            <TextView
                android:id="@+id/inputVolumeList"
                style="@style/SetupStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3" />

            <Button
                android:id="@+id/forgetVolumesButton"
                style="@style/SetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/action_forget_volumes" />
        </LinearLayout>

        <!-- Step 5: remote -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/setup_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SetupStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_remote_title" />

            <Switch
                android:id="@+id/ownVolumeKeysSwitch"
                style="@style/SetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:switchPadding="16dp"
                android:text="@string/own_volume_keys_switch" />

            <TextView
                style="@style/SetupBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/own_volume_keys_body" />

            <Switch
                android:id="@+id/netflixButtonSwitch"
                style="@style/SetupButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:switchPadding="16dp"
                android:text="@string/netflix_button_switch" />

            <TextView
                style="@style/SetupBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/netflix_button_body" />
        </LinearLayout>

        <Button
            android:id="@+id/previewButton"
            style="@style/SetupButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_preview" />
    </LinearLayout>
</ScrollView>
