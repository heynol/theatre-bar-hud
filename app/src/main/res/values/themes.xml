<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BarHud" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/setup_background</item>
        <item name="android:colorAccent">@color/setup_accent</item>
        <item name="android:textColorPrimary">@color/setup_text</item>
        <item name="android:textColorSecondary">@color/setup_text_secondary</item>
    </style>

    <!-- Window host for the HUD. Everything visual is drawn by VolumeHudView and the
         window background set in HudOverlay; this only strips dialog chrome. -->
    <style name="Theme.BarHud.Overlay" parent="android:Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="SetupStepTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/setup_text</item>
    </style>

    <style name="SetupBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/setup_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="SetupStatus">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/setup_text</item>
    </style>

    <style name="SetupButton">
        <item name="android:background">@drawable/setup_button</item>
        <item name="android:textColor">@drawable/setup_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
